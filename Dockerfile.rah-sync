# Multi-stage build for rah-sync CLI
# Final image size: ~15MB on Alpine

# Stage 1: Builder
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /build

# Copy go.mod and go.sum
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o rah-sync ./cmd/rah-sync/

# Stage 2: Runtime
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 rah && adduser -D -u 1000 -G rah rah

# Copy binary from builder
COPY --from=builder /build/rah-sync /usr/local/bin/rah-sync

# Set permissions
RUN chmod +x /usr/local/bin/rah-sync

# Use non-root user
USER rah

# Set working directory to a writable location
WORKDIR /workspace

# Health check: ensure binary works
HEALTHCHECK --interval=30s --timeout=3s --start-period=0s --retries=1 \
    CMD rah-sync -h > /dev/null || exit 1

# Default command
ENTRYPOINT ["rah-sync"]
CMD ["--help"]
